# QuantumRoute AI local development configuration
# Copy to .env and fill in values. .env is git-ignored — never commit real secrets.

# PostgreSQL password for the Compose database (local dev default is fine)
POSTGRES_PASSWORD=change_me_for_local_development

# JWT signing secret — REQUIRED, minimum 32 bytes (64+ hex chars recommended).
# Generate one, e.g.:  openssl rand -hex 32
JWT_SECRET=

# Optimizer HTTP timeouts (milliseconds)
OPTIMIZER_CONNECT_TIMEOUT_MS=3000
OPTIMIZER_READ_TIMEOUT_MS=60000

# CORS allowed origins for the React frontend (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
